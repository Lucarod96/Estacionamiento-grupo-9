@model IEnumerable<Estacionamiento_grupo_9.Models.Pago>

@{
    ViewData["Title"] = "Historial de Pagos";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string busqueda = ViewBag.Busqueda ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt me-2"></i>Gestión de Pagos y Facturación</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Buscador -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-10">
                <input type="text" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por N° Pago o Patente..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Buscar</button>
                @if (!string.IsNullOrEmpty(busqueda))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>N° Pago</th>
                        <th>N° Estadía</th>
                        <th>Patente</th>
                        <th>Fecha Emisión</th>
                        <th>Tarifa ($/h)</th>
                        <th>Total ($)</th>
                        <th>Comprobante</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No hay registros de pagos realizados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.ID_Pago</strong></td>
                                <td>#@item.ID_Estadia</td>
                                <td>
                                    <span class="badge bg-secondary font-monospace">
                                        @(item.Estadia?.Patente ?? "-")
                                    </span>
                                </td>
                                <td>@item.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>$@item.PrecioXHoraAplicado.ToString("N2")</td>
                                <td class="fw-bold text-success">$@item.MontoTotal.ToString("N2")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ComprobanteUrl))
                                    {
                                        <a href="@item.ComprobanteUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-arrow-down me-1"></i>Ver Adjunto
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin adjunto</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.ID_Pago" class="btn btn-sm btn-outline-info" title="Ver Comprobante">
                                        <i class="bi bi-eye-fill"></i> Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación -->
@if (totalPaginas > 1)
{
    <nav class="mt-4" aria-label="Navegación de páginas de pagos">
        <ul class="pagination justify-content-center">
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual - 1)"
                   asp-route-busqueda="@busqueda">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i"
                       asp-route-busqueda="@busqueda">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(paginaActual + 1)"
                   asp-route-busqueda="@busqueda">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
}