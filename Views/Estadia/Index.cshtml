@model Estacionamiento_grupo_9.Models.EstadiaIndexViewModel

@{
    ViewData["Title"] = "Estadías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-car-front me-2"></i>Estadías</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Registrar ingreso</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-6">
                <input type="text" name="busqueda" value="@Model.Busqueda" maxlength="100"
                       class="form-control" placeholder="Buscar por patente, sector o número de plaza..." />
            </div>
            <div class="col-md-4">
                <select name="soloActivas" class="form-select">
                    <option value="true" selected="@Model.SoloActivas">Solo vehículos dentro</option>
                    <option value="false" selected="@(!Model.SoloActivas)">Historial completo</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Patente</th>
                        <th>Plaza</th>
                        <th>Tipo</th>
                        <th>Ingreso</th>
                        <th>Egreso</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No hay estadías para mostrar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><span class="badge bg-secondary font-monospace fs-6">@item.Patente</span></td>
                                <td>
                                    Plaza @item.ID_Plaza
                                    <div class="small text-muted">Piso @item.Piso · Sector @item.Sector</div>
                                </td>
                                <td>@item.Tipo</td>
                                <td>@item.Ingreso.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(item.Egreso?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                <td>
                                    @if (item.Ocupado)
                                    {
                                        <span class="badge bg-success">Dentro</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Finalizada</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (item.Ocupado)
                                    {
                                        <form asp-action="Salir" asp-route-id="@item.ID_Estadia" method="post" class="d-inline"
                                              onsubmit="return confirm('¿Registrar la salida de @item.Patente?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-box-arrow-right me-1"></i>Registrar salida
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<p class="text-muted small mt-2">Total: @Model.TotalRegistros estadía(s)</p>

@if (Model.TotalPaginas > 1)
{
    <nav class="mt-3" aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual - 1)"
                   asp-route-busqueda="@Model.Busqueda" asp-route-soloActivas="@Model.SoloActivas">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i"
                       asp-route-busqueda="@Model.Busqueda" asp-route-soloActivas="@Model.SoloActivas">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PaginaActual + 1)"
                   asp-route-busqueda="@Model.Busqueda" asp-route-soloActivas="@Model.SoloActivas">Siguiente</a>
            </li>
        </ul>
    </nav>
}