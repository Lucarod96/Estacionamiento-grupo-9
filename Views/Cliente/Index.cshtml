@model IEnumerable<Estacionamiento_grupo_9.Models.Cliente>

@{
    ViewData["Title"] = "Gestión de Clientes y Vehículos";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    string busqueda = ViewBag.Busqueda ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-vcard me-2"></i>Clientes / Vehículos</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo Cliente</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Buscador -->
<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-10">
                <input type="text" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por Patente, Nombre, Apellido o Teléfono..." />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Buscar</button>
                @if (!string.IsNullOrEmpty(busqueda))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Patente</th>
                        <th>Apellido y Nombre</th>
                        <th>Teléfono</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No se encontraron clientes o vehículos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary font-monospace fs-6">@item.Patente</span>
                                </td>
                                <td>@item.Apellido, @item.Nombre</td>
                                <td>@item.Telefono</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Patente" class="btn btn-outline-info" title="Detalles"><i class="bi bi-eye-fill"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Patente" class="btn btn-outline-warning" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Patente" class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash-fill"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación por Servidor -->
@if (string.IsNullOrEmpty(busqueda) && totalPaginas > 1)
{
    <nav class="mt-4" aria-label="Navegación de páginas">
        <ul class="pagination justify-content-center">
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= totalPaginas; i++)
            {
                <li class="page-item @(i == paginaActual ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
                </li>
            }

            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}