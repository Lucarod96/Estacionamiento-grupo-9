@using Estacionamiento_grupo_9.Models

@{
    ViewData["Title"] = "Plazas";
}

<style>
    [v-cloak] {
        display: none;
    }

    .lista-tipos-plaza {
        max-height: 180px;
        overflow-y: auto;
    }
</style>

<div id="abm-estacionamiento"
     data-entidad="Plaza"
     data-admin="@(User.IsInRole(Rol.Admin) ? "true" : "false")"
     data-base="@Url.Content("~/")"
     v-cloak>

    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Plazas</h2>

        <button type="button"
                class="btn btn-primary"
                v-if="admin"
                :disabled="guardando"
                v-on:click="abrirNuevo">
            + Nueva plaza
        </button>
    </div>

    <div class="alert alert-danger" v-if="error" role="alert">
        {{ error }}
    </div>

    <div class="alert alert-success" v-if="mensaje" role="status">
        {{ mensaje }}
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form class="row g-2" v-on:submit.prevent="cargar(1)">
                <div class="col-md-10">
                    <input class="form-control"
                           v-model="busqueda"
                           maxlength="100"
                           placeholder="Buscar por ID, sector o tipo..."
                           aria-label="Buscar plazas">
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-outline-primary w-100"
                            :disabled="cargando || guardando">
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <p v-if="cargando" role="status">Cargando...</p>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Piso</th>
                    <th>Sector</th>
                    <th>Tipo de plaza</th>
                    <th>Precio por hora</th>
                    <th class="text-end" v-if="admin">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr v-for="item in items" :key="item.id_Plaza">
                    <td>
                        <span class="badge bg-secondary">
                            {{ item.id_Plaza }}
                        </span>
                    </td>

                    <td>{{ item.piso }}</td>
                    <td>{{ item.sector }}</td>
                    <td>{{ item.tipo }}</td>
                    <td>{{ dinero(item.precioXHora) }}</td>

                    <td class="text-end" v-if="admin">
                        <button type="button"
                                class="btn btn-outline-warning btn-sm me-1"
                                :disabled="guardando"
                                v-on:click="editar(item)">
                            Editar
                        </button>

                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                :disabled="guardando"
                                v-on:click="eliminar(item)">
                            Eliminar
                        </button>
                    </td>
                </tr>

                <tr v-if="!cargando && !items.length">
                    <td :colspan="admin ? 6 : 5"
                        class="text-center py-3">
                        No hay plazas para mostrar.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center my-3">
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                :disabled="pagina <= 1 || cargando || guardando"
                v-on:click="cargar(pagina - 1)">
            Anterior
        </button>

        <span>Página {{ pagina }} de {{ paginas }}</span>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                :disabled="pagina >= paginas || cargando || guardando"
                v-on:click="cargar(pagina + 1)">
            Siguiente
        </button>
    </div>

    <div class="row justify-content-center my-4"
         v-if="abierto && admin">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        {{ nuevo ? 'Nueva plaza' : 'Editar plaza' }}
                    </h4>
                </div>

                <div class="card-body">
                    <form v-on:submit.prevent="guardar">
                        <fieldset :disabled="guardando">

                            <div class="mb-3">
                                <label for="plaza-id" class="form-label">
                                    ID
                                </label>

                                <input id="plaza-id"
                                       class="form-control"
                                       type="number"
                                       min="1"
                                       max="2147483647"
                                       v-model.number="form.id_Plaza"
                                       :readonly="!nuevo"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="plaza-piso" class="form-label">
                                    Piso
                                </label>

                                <input id="plaza-piso"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="200"
                                       v-model.number="form.piso"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="plaza-sector" class="form-label">
                                    Sector
                                </label>

                                <input id="plaza-sector"
                                       class="form-control"
                                       maxlength="45"
                                       v-model.trim="form.sector"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="selector-tipo" class="form-label">
                                    Tipo de plaza
                                </label>

                                <button id="selector-tipo"
                                        type="button"
                                        class="form-select text-start"
                                        :aria-expanded="tiposAbiertos ? 'true' : 'false'"
                                        aria-controls="opciones-tipos"
                                        v-on:click="alternarTipos">
                                    {{ tipoSeleccionado || 'Seleccionar tipo de plaza' }}
                                </button>

                                <div id="opciones-tipos"
                                     class="border rounded mt-1"
                                     v-if="tiposAbiertos">

                                    <p class="p-3 mb-0"
                                       v-if="tipoBuscando"
                                       role="status">
                                        Cargando tipos...
                                    </p>

                                    <div class="list-group list-group-flush lista-tipos-plaza">
                                        <button type="button"
                                                class="list-group-item list-group-item-action"
                                                v-for="tipo in tipos"
                                                :key="tipo.id_TipoDePlaza"
                                                :disabled="tipoBuscando"
                                                v-on:click="elegirTipo(tipo)">
                                            {{ tipo.tipo }}
                                            — {{ dinero(tipo.precioXHora) }} por hora
                                        </button>
                                    </div>

                                    <p class="p-3 mb-0"
                                       v-if="tipoConsultado && !tipoBuscando && !tipos.length">
                                        No hay tipos de plaza disponibles.
                                    </p>

                                    <div class="d-flex justify-content-between p-2 border-top"
                                         v-if="tipoConsultado && tipos.length">

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                :disabled="tipoPagina <= 1 || tipoBuscando"
                                                v-on:click="buscarTipos(tipoPagina - 1)">
                                            Anteriores
                                        </button>

                                        <span class="align-self-center">
                                            Página {{ tipoPagina }}
                                        </span>

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                :disabled="!tiposHayMas || tipoBuscando"
                                                v-on:click="buscarTipos(tipoPagina + 1)">
                                            Siguientes
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary"
                                    :disabled="guardando || tipoBuscando">
                                {{ guardando ? 'Guardando...' : 'Guardar' }}
                            </button>

                            <button type="button"
                                    class="btn btn-secondary ms-2"
                                    v-on:click="abierto = false">
                                Cancelar
                            </button>

                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<noscript>
    Activá JavaScript para utilizar este módulo.
</noscript>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3.5.13/dist/vue.global.prod.js"></script>
    <script src="~/js/abm-estacionamiento.js"
            asp-append-version="true"></script>
}