@using Estacionamiento_grupo_9.Models

@{
    ViewData["Title"] = "Tipos de plaza";
}

<style>
    [v-cloak] {
        display: none;
    }
</style>

<div id="abm-estacionamiento"
     data-entidad="TipoDePlaza"
     data-admin="@(User.IsInRole(Rol.Admin) ? "true" : "false")"
     data-base="@Url.Content("~/")"
     v-cloak>

    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tipos de plaza</h2>

        <button type="button"
                class="btn btn-primary"
                v-if="admin"
                :disabled="guardando"
                v-on:click="abrirNuevo">
            + Nuevo tipo
        </button>
    </div>

    <div class="alert alert-danger" v-if="error" role="alert">
        {{ error }}
    </div>

    <div class="alert alert-success" v-if="mensaje" role="status">
        {{ mensaje }}
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form class="row g-2" v-on:submit.prevent="cargar(1)">
                <div class="col-md-10">
                    <input class="form-control"
                           v-model="busqueda"
                           maxlength="100"
                           placeholder="Buscar por tipo..."
                           aria-label="Buscar por tipo">
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-outline-primary w-100"
                            :disabled="cargando || guardando">
                        Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <p v-if="cargando">Cargando...</p>

    <div class="table-responsive shadow-sm">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tipo</th>
                    <th>Precio por hora</th>
                    <th class="text-end" v-if="admin">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <tr v-for="item in items" :key="item.id_TipoDePlaza">
                    <td>
                        <span class="badge bg-secondary">
                            {{ item.id_TipoDePlaza }}
                        </span>
                    </td>

                    <td>{{ item.tipo }}</td>
                    <td>{{ dinero(item.precioXHora) }}</td>

                    <td class="text-end" v-if="admin">
                        <button type="button"
                                class="btn btn-outline-warning btn-sm me-1"
                                :disabled="guardando"
                                v-on:click="editar(item)">
                            Editar
                        </button>

                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                :disabled="guardando"
                                v-on:click="eliminar(item)">
                            Eliminar
                        </button>
                    </td>
                </tr>

                <tr v-if="!cargando && !items.length">
                    <td :colspan="admin ? 4 : 3" class="text-center py-3">
                        No hay tipos de plaza para mostrar.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center my-3">
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                :disabled="pagina <= 1 || cargando || guardando"
                v-on:click="cargar(pagina - 1)">
            Anterior
        </button>

        <span>Página {{ pagina }} de {{ paginas }}</span>

        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                :disabled="pagina >= paginas || cargando || guardando"
                v-on:click="cargar(pagina + 1)">
            Siguiente
        </button>
    </div>

    <div class="row justify-content-center my-4" v-if="abierto && admin">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        {{ nuevo ? 'Nuevo tipo de plaza' : 'Editar tipo de plaza' }}
                    </h4>
                </div>

                <div class="card-body">
                    <form v-on:submit.prevent="guardar">
                        <fieldset :disabled="guardando">
                            <div class="mb-3">
                                <label for="tipo-id" class="form-label">ID</label>
                                <input id="tipo-id"
                                       class="form-control"
                                       type="number"
                                       min="1"
                                       max="2147483647"
                                       v-model.number="form.id_TipoDePlaza"
                                       :readonly="!nuevo"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="tipo-nombre" class="form-label">
                                    Tipo
                                </label>
                                <input id="tipo-nombre"
                                       class="form-control"
                                       maxlength="45"
                                       v-model.trim="form.tipo"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="tipo-precio" class="form-label">
                                    Precio por hora
                                </label>
                                <input id="tipo-precio"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       max="99999999.99"
                                       step="0.01"
                                       v-model.number="form.precioXHora"
                                       required>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                {{ guardando ? 'Guardando...' : 'Guardar' }}
                            </button>

                            <button type="button"
                                    class="btn btn-secondary ms-2"
                                    v-on:click="abierto = false">
                                Cancelar
                            </button>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<noscript>Activá JavaScript para utilizar este módulo.</noscript>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3.5.13/dist/vue.global.prod.js"></script>
    <script src="~/js/abm-estacionamiento.js"
            asp-append-version="true"></script>
}